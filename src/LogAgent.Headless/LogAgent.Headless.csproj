<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-LogAgent.Headless-b5a7b765-6a78-4f7f-ad6a-e0cb834440ce</UserSecretsId>
    <!-- 发布用：无头服务同时支持 Windows 与 Linux（x64 / arm64） -->
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置技能随程序发布（与桌面壳同一份目录） -->
    <Content Include="..\LogAgent.App\skills\**\*" Link="skills\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogAgent.Shared\LogAgent.Shared.csproj" />
    <ProjectReference Include="..\LogAgent.Core\LogAgent.Core.csproj" />
    <ProjectReference Include="..\LogAgent.Routing\LogAgent.Routing.csproj" />
    <ProjectReference Include="..\LogAgent.Memory\LogAgent.Memory.csproj" />
    <ProjectReference Include="..\LogAgent.Knowledge\LogAgent.Knowledge.csproj" />
    <ProjectReference Include="..\LogAgent.Training\LogAgent.Training.csproj" />
    <!-- 无头常驻需要连接层与 NapCat 托管（v0.7.0 只做 CLI 子命令时缺失） -->
    <ProjectReference Include="..\LogAgent.Connections\LogAgent.Connections.csproj" />
    <ProjectReference Include="..\LogAgent.NapCat\LogAgent.NapCat.csproj" />
    <ProjectReference Include="..\LogAgent.Sandbox\LogAgent.Sandbox.csproj" />
  </ItemGroup>
</Project>
