<Page x:Class="LogAgent.App.Pages.SandboxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="沙箱管理">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="沙箱管理" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Style="{StaticResource SubtitleText}" Margin="0,0,0,16"
                   Text="Agent 的文件操作与 Shell 限定在任务工作区内执行；命令需通过白名单，全程审计。"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Audit}" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource ControlStroke}" BorderThickness="1" RowHeight="28" ColumnHeaderHeight="30" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="120"/>
                <DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="*"/>
                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="180"/>
                <DataGridTextColumn Header="耗时" Binding="{Binding Duration}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,16,0,4"
                   Text="{Binding ShellInfo}"/>
        <TextBlock Grid.Row="4" FontSize="12" Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{Binding LegacyHint}"
                   Visibility="{Binding HasLegacyHint, Converter={StaticResource BoolToVisibility}}"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,8">
            <TextBlock Text="命令白名单 / 黑名单" FontSize="14" FontWeight="Medium"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock FontSize="12" Foreground="{StaticResource TextTertiary}"
                       Margin="12,2,0,0" Text="{Binding SaveHint}"/>
        </StackPanel>
        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="白名单可执行名（逗号分隔）" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding WhitelistText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="False" MinHeight="72" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="黑名单正则（每行一条，优先于白名单）" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding BlacklistText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,0,10">
            <Button Content="恢复平台默认" Command="{Binding ResetToDefaultsCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="保存配置" Command="{Binding SaveCommand}" Padding="14,6"/>
        </StackPanel>
    </Grid>
</Page>
