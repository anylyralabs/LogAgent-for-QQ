<Page x:Class="LogAgent.App.Pages.OfficialBotPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="官方 Bot">
    <ScrollViewer Padding="32">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：扫码接入 + 凭证 -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="官方 Bot" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource SubtitleText}" Margin="0,0,0,20"
                           Text="QQ 开放平台官方机器人通道（扫码创建，凭证连接）"/>

                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="① 扫码连接（推荐）" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22">
                            点击「显示二维码」，用手机 QQ 扫码完成机器人绑定——
                            成功后 <Run FontWeight="SemiBold">AppID / AppSecret 会自动填入下方表单</Run>，无需手动复制。
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="StartQrBtn" Content="显示二维码" Click="StartQr_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                            <Button x:Name="CancelQrBtn" Content="取消扫码" Click="CancelQr_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                            <Button Content="在浏览器中打开" Click="OpenScanPage_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Image x:Name="QrImage" Width="180" Height="180" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="QrStatus" VerticalAlignment="Bottom" Margin="12,0,0,6"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="② 填写凭证" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="AppID" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="AppIdBox" Margin="0,4" MinWidth="360" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Text="AppSecret" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,8"/>
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="SecretBox" Margin="0,4" MinWidth="360" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Text="沙箱环境" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,10"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="SandboxCheck" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="3" Text="启用" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,10"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="EnabledCheck" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="保存凭证" Click="Save_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SaveHint" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource OkFill}"/>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="AppSecret 仅在创建时完整展示一次，请妥善保存；泄露可在开放平台重置。"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右栏：连接状态 + 说明 -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,58,0,16">
                    <StackPanel>
                        <TextBlock Text="连接" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text="未连接"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ConnectBtn" Content="连接" Click="Connect_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                            <Button x:Name="DisconnectBtn" Content="断开" Click="Disconnect_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="与 OneBot（NapCat）的区别" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20">
                            · <Run FontWeight="SemiBold">官方 Bot</Run>：QQ 开放平台通道，扫码创建机器人拿凭证连接（本页）；消息范围受平台规则限制。<LineBreak/>
                            · <Run FontWeight="SemiBold">OneBot</Run>：第三方协议端 NapCat，扫码登录一个 QQ 号，能力更接近真人账号（侧边栏「OneBot 连接」页）。<LineBreak/><LineBreak/>
                            两者可同时配置，选其一启用即可。
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
