<Page x:Class="LogAgent.App.Pages.SessionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="会话管理">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="会话管理" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Style="{StaticResource SubtitleText}" Margin="0,0,0,16"
                   Text="会话按超时/容量/手动/服务停止自动切段，切段时生成 L1 摘要；原文（L0）全量保留，用于训练数据导出。"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  Background="Transparent" RowBackground="Transparent"
                  GridLinesVisibility="Horizontal" BorderBrush="{StaticResource ControlStroke}" BorderThickness="1"
                  RowHeight="30" ColumnHeaderHeight="30" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="会话" Binding="{Binding ChatId}" Width="110"/>
                <DataGridTextColumn Header="类型" Binding="{Binding ChatType}" Width="70"/>
                <DataGridTextColumn Header="开始" Binding="{Binding StartTime}" Width="110"/>
                <DataGridTextColumn Header="结束" Binding="{Binding EndTime}" Width="110"/>
                <DataGridTextColumn Header="切断原因" Binding="{Binding CutReason}" Width="90"/>
                <DataGridTextColumn Header="消息数" Binding="{Binding MessageCount}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12">
            <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="手动切段（选中/进行中）" Command="{Binding CutActiveCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="导出训练数据（脱敏 JSONL）" Command="{Binding ExportTrainingCommand}" Padding="14,6" FontWeight="Medium"/>
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <TextBlock Text="会话 L1 摘要（选中行）" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding SelectedSession.Summary, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100"
                         VerticalScrollBarVisibility="Auto" Background="#FAFAF8" BorderBrush="#D3D1C7"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
