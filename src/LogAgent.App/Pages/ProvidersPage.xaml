<Page x:Class="LogAgent.App.Pages.ProvidersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="模型路由">
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- 左主栏 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="模型路由" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource SubtitleText}"
                               Text="按任务类型分流到 Provider 优先链，失败自动切换，连续失败 3 次熔断 60 秒"/>
                </StackPanel>
                <Button Content="保存配置" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <!-- Provider 列表 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Provider（OpenAI 兼容接口）" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="双击一行可编辑" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="ProvidersGrid" ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedProvider}"
                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              IsReadOnly="True" MouseDoubleClick="ProvidersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="84"/>
                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="*"/>
                            <DataGridTextColumn Header="ApiKey" Binding="{Binding ApiKey}" Width="95"/>
                            <DataGridTextColumn Header="ChatModel" Binding="{Binding ChatModel}" Width="108"/>
                            <DataGridTextColumn Header="上下文" Binding="{Binding ContextDisplay}" Width="56"/>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="46"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="AddProviderButton" Content="添加模型…" Click="AddProvider_Click" Margin="0,0,8,0"/>
                        <Button x:Name="EditProviderButton" Content="编辑选中…" Click="EditProvider_Click" Margin="0,0,8,0"/>
                        <Button Content="删除选中" Command="{Binding RemoveProviderCommand}" Margin="0,0,8,0"/>
                        <Button Content="测试选中连接" Command="{Binding TestSelectedCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 任务分流规则 -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="任务分流规则" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,8"
                               Text="优先链按 Provider 名称填写（逗号分隔，前者优先）；前面的失败会自动切换下一个"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding TaskType}" FontSize="11"
                                                       Foreground="{StaticResource TextTertiary}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="2" Text="{Binding ChainText, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 右栏：测试 + 说明 -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,58,0,16">
                <StackPanel>
                    <TextBlock Text="连接测试" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding CurrentSelectionText}" FontSize="12.5"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="测试选中连接" Command="{Binding TestSelectedCommand}"
                            Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{Binding TestResultBrush}" LineHeight="20"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="工作机制" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21">
                        · 每个任务类型（聊天/日志分析/深度推理/摘要/Embedding）各有独立优先链<LineBreak/>
                        · 请求失败自动切链中下一个 Provider<LineBreak/>
                        · 某 Provider 连续失败 3 次即熔断 60 秒（仪表盘可见计量）<LineBreak/>
                        · 配好 <Run FontWeight="SemiBold">EmbeddingModel</Run> 后，知识库检索自动升级为「关键词 + 向量」混合模式
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
