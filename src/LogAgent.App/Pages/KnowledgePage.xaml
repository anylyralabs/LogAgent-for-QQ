<Page x:Class="LogAgent.App.Pages.KnowledgePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="知识库">
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- 左主栏 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="知识库" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource SubtitleText}"
                               Text="候选知识审核后转正才会进入回答检索；文档导入直接生效（重复导入自动替换）；群友告知与网页学习默认进候选"/>
                </StackPanel>
                <Button Content="刷新" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <!-- 知识条目 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="知识条目" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox SelectedValuePath="Tag" Width="110" VerticalAlignment="Center"
                                      SelectedValue="{Binding StatusFilter}">
                                <ComboBoxItem Content="待审核" Tag="candidate"/>
                                <ComboBoxItem Content="已生效" Tag="approved"/>
                                <ComboBoxItem Content="已拒绝" Tag="rejected"/>
                                <ComboBoxItem Content="全部" Tag=""/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextTertiary}">
                            <Run Text="待审核 "/><Run Text="{Binding PendingCount, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" 条"/>
                        </TextBlock>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="44"/>
                            <DataGridTextColumn Header="来源" Binding="{Binding SourceDisplay}" Width="90"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="76"/>
                            <DataGridTextColumn Header="内容" Binding="{Binding Display}" Width="*"/>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="96"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="✔ 转正生效" Command="{Binding ApproveCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                            <Button Content="✘ 拒绝" Command="{Binding RejectCommand}" Margin="0,0,8,0"/>
                            <Button Content="删除" Command="{Binding DeleteCommand}" Margin="0,0,16,0"/>
                            <Button x:Name="ImportFilesButton" Content="导入文件…" Click="ImportFiles_Click" Margin="0,0,8,0"/>
                            <Button x:Name="ImportFolderButton" Content="导入文件夹…" Click="ImportFolder_Click"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ImportStatus}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource TextTertiary}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 手动录入 -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="手动录入（直接转正生效）" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewContent, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"
                                 VerticalScrollBarVisibility="Auto"/>
                        <Button Grid.Column="2" Content="添加" Command="{Binding AddManualCommand}"
                                Style="{StaticResource AccentButton}" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 右栏：审核概览 + 说明 -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,58,0,16">
                <StackPanel>
                    <TextBlock Text="审核概览" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="待审核" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarnFill}" Text="{Binding PendingCount, Mode=OneWay}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="已生效" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource OkFill}" Text="{Binding ApprovedCount, Mode=OneWay}"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="已拒绝" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiary}" Text="{Binding RejectedCount, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="学习与检索机制" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21">
                        · 导入文档（.md/.txt/.log）→ 按 ## 标题切块，直接生效；重复导入自动替换<LineBreak/>
                        · 群内发 <Run FontWeight="SemiBold">记住：xxx</Run> → 提炼后进候选区<LineBreak/>
                        · 群内发 <Run FontWeight="SemiBold">学习 https://…</Run> → 抓网页提炼进候选区<LineBreak/>
                        · 转正后的知识在回答时自动检索并带引用编号<LineBreak/>
                        · 检索＝中文二元组全文（BM25 标题加权）＋ 向量（配 EmbeddingModel 后自动启用）<LineBreak/>
                        · 低质量知识建议直接拒绝或删除，保持检索干净
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
