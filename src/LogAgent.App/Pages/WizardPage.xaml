<Page x:Class="LogAgent.App.Pages.WizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="首次启动向导">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 步骤指示 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
            <TextBlock x:Name="StepDots" Text="● ○ ○" FontSize="16" Foreground="{StaticResource AccentText}" TextAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="40">
            <Grid>
                <!-- Step 0: 欢迎 -->
                <StackPanel x:Name="Step0">
                    <Image Source="/Assets/logo-128.png" Width="96" Height="96" HorizontalAlignment="Center"
                           Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="欢迎使用 LogAgent" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="一只住在 QQ 群里的日志分析小狐狸" FontSize="14" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                    <TextBlock FontSize="13.5" Foreground="{StaticResource TextSecondary}" LineHeight="26" TextWrapping="Wrap">
                        三分钟完成初始化，之后她就能在群里帮你：<LineBreak/>
                        · 回答技术问题（带群上下文记忆 + 知识库引用）<LineBreak/>
                        · 分析日志文件，给出带证据的根因报告<LineBreak/>
                        · 从群友回答和网页中学习新知识，越用越懂行<LineBreak/><LineBreak/>
                        接下来两步：<Run FontWeight="Medium">① 配置一个模型通道</Run>（任意 OpenAI 兼容接口，可跳过稍后配）→
                        <Run FontWeight="Medium">② 接入 QQ</Run>（官方 Bot 优先；NapCat 作为备用通道）。
                    </TextBlock>
                </StackPanel>

                <!-- Step 1: 模型配置 -->
                <StackPanel x:Name="Step1" Visibility="Collapsed">
                    <TextBlock Text="① 配置模型通道" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="OpenAI 兼容接口即可（含 DeepSeek/通义/本地 vLLM 等）" FontSize="12.5" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="名称" FontSize="12" Foreground="#5F5E5A" VerticalAlignment="Center" Margin="0,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="WizName" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="Endpoint" FontSize="12" Foreground="#5F5E5A" VerticalAlignment="Center" Margin="0,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="WizEndpoint" Margin="0,4" Text="https://api.deepseek.com/v1"/>
                        <TextBlock Grid.Row="2" Text="ApiKey" FontSize="12" Foreground="#5F5E5A" VerticalAlignment="Center" Margin="0,8"/>
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="WizKey" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Text="ChatModel" FontSize="12" Foreground="#5F5E5A" VerticalAlignment="Center" Margin="0,8"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="WizModel" Margin="0,4" Text="deepseek-chat"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="TestBtn" Content="测试连接" Click="TestBtn_Click" Padding="14,6"/>
                        <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12.5" Foreground="#0F6E56"/>
                    </StackPanel>
                    <TextBlock Text="没有 API Key？可以先跳过，稍后在「模型路由」页配置。" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Step 2: QQ 接入指引（官方 Bot 优先，NapCat 备用） -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock Text="② 接入 QQ（官方 Bot 优先）" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13.5" Foreground="{StaticResource TextSecondary}" LineHeight="26" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">推荐：官方 Bot</Run> —— 左侧「官方 Bot」页扫码创建/绑定，凭证会自动填入并保存，
                        点「连接」即可。支持 Markdown、主动消息；群聊主动发言需群主在 QQ 里开启。<LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold">备用：NapCat</Run> —— 去左侧「NapCat 管理」页：<LineBreak/>
                        1. 填入 NapCat 目录（Shell 版解压目录）→ 启动 NapCat<LineBreak/>
                        2. 用手机 QQ 扫码登录（二维码直接显示在页面里）<LineBreak/>
                        3. NapCat WebUI 里添加反向 WebSocket，地址填：<LineBreak/>
                    </TextBlock>
                    <Border Background="{StaticResource LayerFill}" BorderBrush="{StaticResource ControlStroke}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="12,4">
                        <TextBlock x:Name="WsUrlText" Text="ws://127.0.0.1:6701/onebot/v11/ws" FontFamily="{StaticResource MonoFont}" FontSize="13.5" Foreground="{StaticResource AccentText}"/>
                    </Border>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextTertiary}" Margin="0,12,0,0">
                        建议使用有正常使用记录的 QQ 小号；「Bot 服务」启动后即完成接入。
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="跳过向导，直接进入" Click="SkipBtn_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PrevBtn" Content="上一步" Click="PrevBtn_Click" Margin="0,0,8,0" Visibility="Hidden"/>
                <Button x:Name="NextBtn" Content="下一步" Click="NextBtn_Click" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
