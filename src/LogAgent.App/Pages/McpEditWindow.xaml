<Window x:Class="LogAgent.App.Pages.McpEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogAgent — 添加 MCP 服务器" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="/Assets/logo.png" Background="{StaticResource WindowBackground}">
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderText" Text="添加 MCP 服务器" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="接入标准 Model Context Protocol 服务器，其工具会自动暴露给小炎（stdio 本地进程 / Streamable HTTP）"/>
        </StackPanel>

        <!-- 表单 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="名称" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,12"/>

                <TextBlock Text="传输方式" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <ComboBox x:Name="TransportCombo" Margin="0,0,0,12" SelectionChanged="Transport_Changed">
                    <ComboBoxItem Content="stdio（本地命令子进程，如 npx / python / uvx）"/>
                    <ComboBoxItem Content="http（Streamable HTTP 远程服务）"/>
                </ComboBox>

                <!-- stdio 组 -->
                <StackPanel x:Name="StdioGroup">
                    <TextBlock Text="命令" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="CommandBox" Margin="0,0,0,4"/>
                    <TextBlock Text="可执行命令（npx / uvx / python / 完整 exe 路径）"
                               FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,10"/>

                    <TextBlock Text="参数" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ArgsBox" Margin="0,0,0,4"/>
                    <TextBlock Text="命令参数（一行，空格分隔），例如：-y @modelcontextprotocol/server-filesystem C:\"
                               FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,10"/>

                    <TextBlock Text="工作目录（可选）" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="WorkdirBox" Margin="0,0,0,10"/>

                    <TextBlock Text="环境变量（每行一条 KEY=VALUE，可选）" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="EnvBox" AcceptsReturn="True" MinLines="2" MaxLines="5" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="例如：GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxx（不随日志输出）"
                               FontSize="11.5" Foreground="{StaticResource TextTertiary}"/>
                </StackPanel>

                <!-- http 组 -->
                <StackPanel x:Name="HttpGroup" Visibility="Collapsed">
                    <TextBlock Text="URL" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="UrlBox" Margin="0,0,0,4"/>
                    <TextBlock Text="Streamable HTTP 端点，例如 http://127.0.0.1:8931/mcp"
                               FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,10"/>

                    <TextBlock Text="请求头（每行一条 Key: Value，可选）" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="HeadersBox" AcceptsReturn="True" MinLines="2" MaxLines="5" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="例如：Authorization: Bearer xxx"
                               FontSize="11.5" Foreground="{StaticResource TextTertiary}"/>
                </StackPanel>

                <CheckBox x:Name="EnabledToggle" Content="启用该服务器（保存后自动连接）" IsChecked="True" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <!-- 测试状态（就地显示） -->
        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0"/>

        <!-- 按钮行 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="TestBtn" Content="测试连接" Click="Test_Click" Margin="0,0,8,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click" MinWidth="88" Margin="0,0,8,0"/>
                <Button x:Name="SaveBtn" Content="保存" Click="Save_Click" MinWidth="88" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
