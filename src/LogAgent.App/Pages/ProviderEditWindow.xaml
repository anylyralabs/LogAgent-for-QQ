<Window x:Class="LogAgent.App.Pages.ProviderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogAgent — 添加模型" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="/Assets/logo.png" Background="{StaticResource WindowBackground}">
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderText" Text="添加模型" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="配置一个 OpenAI 兼容接口的模型通道（DeepSeek / 通义 / 本地 vLLM 等均可）"/>
        </StackPanel>

        <!-- 表单 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="名称" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,12"/>

                <TextBlock Text="API 地址（OpenAI 兼容）" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="EndpointBox" Margin="0,0,0,4"/>
                <TextBlock Text="例如 https://api.deepseek.com/v1 —— 路径需含 /v1（不写协议头会自动补 https://）"
                           FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,12"/>

                <TextBlock Text="API Key" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="ApiKeyBox" Margin="0,0,0,4"/>
                <TextBlock Text="仅保存在本机 config.json；本地服务无需鉴权时可留空"
                           FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Chat 模型名" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <Button x:Name="FetchModelsButton" Content="获取模型列表" Click="FetchModels_Click"
                                    HorizontalAlignment="Right" MinHeight="0" Height="26" Padding="10,0" FontSize="11.5"/>
                        </Grid>
                        <ComboBox x:Name="ChatModelCombo" IsEditable="True" IsTextSearchEnabled="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="向量模型名（可选）" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="EmbeddingModelCombo" IsEditable="True" IsTextSearchEnabled="True"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="向量模型用于知识库检索升级为「关键词 + 向量」混合模式；留空则保持关键词检索"
                           FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,4"/>
                <TextBlock x:Name="ModelMetaHint" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                           TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

                <TextBlock Text="高级参数" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="最大输出 tokens" FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="MaxTokensBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="温度（0-2）" FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TemperatureBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="超时（秒）" FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TimeoutBox"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="EnabledToggle" Content="启用该模型通道" IsChecked="True" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <!-- 测试/校验状态（就地显示） -->
        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12.5" TextWrapping="Wrap"
                   LineHeight="20" Margin="2,12,2,0" Visibility="Collapsed"/>

        <!-- 按钮行 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="TestBtn" Content="测试连接" Click="Test_Click" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsDefault="True"
                        Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
