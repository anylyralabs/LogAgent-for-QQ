<Page x:Class="LogAgent.App.Pages.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:LogAgent.App.Pages"
      Title="对话">
    <Page.Resources>
        <!-- 用户气泡（右侧、主色） -->
        <DataTemplate x:Key="UserBubble">
            <StackPanel HorizontalAlignment="Right" Margin="56,0,4,14">
                <Border Background="{StaticResource AccentFill}" CornerRadius="10,10,3,10"
                        Padding="12,8" MaxWidth="430" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextOnAccent}"
                               FontSize="13.5" LineHeight="21" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource TextTertiary}"
                           HorizontalAlignment="Right" Margin="0,4,2,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- 机器人气泡（左侧、卡片白） -->
        <DataTemplate x:Key="AgentBubble">
            <StackPanel HorizontalAlignment="Left" Margin="4,0,56,14">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                    <TextBlock Text="小炎" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"/>
                    <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="8,1,0,0"/>
                </StackPanel>
                <Border Background="{StaticResource CardBackground}" CornerRadius="10,10,10,3"
                        BorderBrush="{StaticResource CardStroke}" BorderThickness="1"
                        Padding="12,8" MaxWidth="430" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimary}"
                               FontSize="13.5" LineHeight="21" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 系统提示（居中灰字） -->
        <DataTemplate x:Key="NoteLine">
            <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource TextTertiary}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="24,2,24,12"/>
        </DataTemplate>

        <pages:ChatMessageTemplateSelector x:Key="ChatSelector"
            UserTemplate="{StaticResource UserBubble}"
            AgentTemplate="{StaticResource AgentBubble}"
            NoteTemplate="{StaticResource NoteLine}"/>
    </Page.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- 左：对话主区 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="对话" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource SubtitleText}"
                               Text="在本机直接与机器人对话——与 QQ 消息共用同一套处理管线（会话记忆 / 知识库 / 日志分析）"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                    <Button x:Name="NewTopicButton" Content="新话题" Command="{Binding NewTopicCommand}" Margin="0,0,8,0"/>
                    <Button x:Name="ClearChatButton" Content="清空显示" Command="{Binding ClearCommand}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 消息区 -->
                    <ScrollViewer x:Name="MessagesScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  Padding="18,16,18,4" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Messages}"
                                      ItemTemplateSelector="{StaticResource ChatSelector}"/>
                    </ScrollViewer>

                    <!-- 正在思考提示（IsBusy 时显示） -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{StaticResource AccentText}" Margin="0,0,8,0"/>
                        <TextBlock Text="小炎正在思考…" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <!-- 输入区 -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource DividerStroke}" BorderThickness="0,1,0,0"
                            Padding="14,12,14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="InputBox" MinHeight="38" MaxHeight="110"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Center" Padding="10,7"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="Input_KeyDown"/>
                                <Button Grid.Column="2" x:Name="SendButton" Content="发送" Height="38" MinWidth="76"
                                        Style="{StaticResource AccentButton}" VerticalAlignment="Bottom"
                                        Command="{Binding SendCommand}"/>
                            </Grid>
                            <TextBlock Grid.Row="1" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                       Margin="2,8,0,0" TextWrapping="Wrap"
                                       Text="Enter 发送 · Shift+Enter 换行 · 支持命令：「新话题」「记住：xxx」「学习 https://…」"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 右栏：状态 + 快捷输入 + 说明 -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,58,0,16">
                <StackPanel>
                    <TextBlock Text="对话状态" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模型通道" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="ModelChannelText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"
                                   MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OneBot 服务" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="OneBotStateText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="官方 Bot" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="OfficialStateText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock x:Name="ModelHint" FontSize="12" Foreground="{StaticResource WarnFill}"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0" Visibility="Collapsed"
                               Text="尚未配置模型：先去「模型路由」页添加 Provider 并保存，之后对话即可正常回复。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="快捷输入" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <Button x:Name="QuickHelloButton" Content="你好，介绍一下你自己"
                            Tag="你好，介绍一下你自己" Click="QuickInput_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button x:Name="QuickLogButton" Content="分析日志示例（点击填入）"
                            Click="QuickLog_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button x:Name="QuickRememberButton" Content="记住一条知识（点击填入）"
                            Click="QuickRemember_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button x:Name="QuickNewTopicButton" Content="发送「新话题」切换会话"
                            Tag="新话题" Click="QuickInput_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="说明" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" LineHeight="21"
                               Text="· 消息与 QQ 完全同管线：会话记忆、知识库检索、日志分析都会生效&#x0a;· 对话会保存到会话库（chat = local-console），随训练数据一起导出&#x0a;· 支持命令：新话题 / 记住：xxx / 学习 https://…&#x0a;· 「清空显示」只清界面，不影响已保存记录"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
