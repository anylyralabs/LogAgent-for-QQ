<Page x:Class="LogAgent.App.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="仪表盘">
    <ScrollViewer Padding="32">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="仪表盘" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource SubtitleText}"
                               Text="连接 · 会话 · 知识库 · 模型路由 全景"/>
                </StackPanel>
                <Button Content="刷新" Click="Refresh_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <!-- 连接状态总览 -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="连接状态" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="官方 Bot（QQ 开放平台）" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="OfficialBotState" Text="未连接" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBlock x:Name="OfficialBotSub" Text="—" FontSize="11.5" Foreground="{StaticResource TextTertiary}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="OneBot 服务（反向 WS）" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="OneBotState" Text="未启动" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBlock x:Name="OneBotSub" Text="—" FontSize="11.5" Foreground="{StaticResource TextTertiary}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="NapCat 协议端" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="NapCatState" Text="未配置" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBlock x:Name="NapCatSub" Text="—" FontSize="11.5" Foreground="{StaticResource TextTertiary}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 统计卡 -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="会话总数" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="SessionCountText" Text="-" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentText}" Margin="0,6,0,2"/>
                        <TextBlock x:Name="SessionSub" Text="—" FontSize="11.5" Foreground="{StaticResource TextTertiary}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="问答对" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="TurnCountText" Text="-" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentText}" Margin="0,6,0,2"/>
                        <TextBlock x:Name="TurnSub" Text="—" FontSize="11.5" Foreground="{StaticResource TextTertiary}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="知识库" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="KnowledgeText" Text="-" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentText}" Margin="0,6,0,2"/>
                        <TextBlock x:Name="KnowledgeSub" Text="—" FontSize="11.5" Foreground="{StaticResource TextTertiary}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="模型调用" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="ModelCallText" Text="-" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentText}" Margin="0,6,0,2"/>
                        <TextBlock x:Name="ModelCallSub" Text="—" FontSize="11.5" Foreground="{StaticResource TextTertiary}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 模型路由计量 -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="模型路由计量（自服务启动以来）" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <DataGrid x:Name="StatsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" IsReadOnly="True" MinHeight="90">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="110"/>
                            <DataGridTextColumn Header="模型" Binding="{Binding Model}" Width="150"/>
                            <DataGridTextColumn Header="成功" Binding="{Binding Ok}" Width="70"/>
                            <DataGridTextColumn Header="失败" Binding="{Binding Fail}" Width="70"/>
                            <DataGridTextColumn Header="Tokens (P+C)" Binding="{Binding TotalTokens}" Width="120"/>
                            <DataGridTextColumn Header="平均延迟 (ms)" Binding="{Binding AvgLatencyMs, StringFormat=F0}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="StatsEmptyHint" Text="暂无调用记录——启动 Bot 服务或测试连接后在此查看计量"
                               FontSize="12.5" Foreground="{StaticResource TextTertiary}" Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="TodayUsageText" Text="今日累计：暂无调用"
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 配置与数据 -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="配置与数据" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ConfigPathText" Text="-" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DbPathText" Text="-" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
