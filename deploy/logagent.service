[Unit]
Description=LogAgent QQ 日志分析助手（无头服务）
Documentation=https://github.com/anylyralabs/LogAgent-for-QQ
After=network-online.target
Wants=network-online.target
# 防止异常时无限热重启（5 分钟内最多 10 次）；正常 WS 重连由应用内部退避处理
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# 专用账号运行时把下面的 User 与 HOME/日志目录改成对应值
User=logagent
Group=logagent
WorkingDirectory=/opt/logagent
Environment=HOME=/var/lib/logagent
Environment=LOGAGENT_CONFIG_DIR=/var/lib/logagent/config
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
ExecStart=/opt/logagent/LogAgent.Headless serve
# 进程意外退出/正常退出都拉起；应用内部已有 WS 退避重连
Restart=always
RestartSec=10
# systemd 停止时发 SIGTERM；应用据此切段会话后退出
KillSignal=SIGTERM
# 退出时要先停频道、再生成各会话 L1 摘要（走模型），留足时间
TimeoutStopSec=60

# 资源与日志护栏
TasksMax=256
LimitNOFILE=65535
MemoryHigh=768M
MemoryMax=1G
OOMPolicy=restart
LogRateLimitIntervalSec=30
LogRateLimitBurst=200

# 基础加固（按需放宽）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/logagent

[Install]
WantedBy=multi-user.target
